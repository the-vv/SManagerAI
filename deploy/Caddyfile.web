# Inner web container: serves the Angular build and proxies /api to the NestJS container.
# TLS is terminated by your existing Caddy / Cloudflare in front of this container.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /index.html Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
	}
}
