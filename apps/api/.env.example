# --- Server ---
NODE_ENV=development
PORT=3000
# SQLite file. In Docker this is file:/data/smanager.db on a persistent local volume.
DATABASE_URL=file:./dev.db

# --- Auth / sessions ---
SESSION_TTL_DAYS=30
# true in production (cookies only sent over HTTPS)
COOKIE_SECURE=false
# Registration: the first account can always be created. Set to true to allow more.
ALLOW_REGISTRATION=true
# Comma separated list of allowed browser origins (web dev server, Capacitor app).
CORS_ORIGINS=http://localhost:4200,https://localhost,capacitor://localhost,http://localhost
# Optional Google login (see docs/GOOGLE_OAUTH.md)
GOOGLE_CLIENT_ID=

# --- Scheduler ---
# Cron for the automation processor (default every 5 minutes) and enable flag.
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/5 * * * *

# Rate limiting of login/register/password endpoints (in-memory, single instance)
RATE_LIMIT_ENABLED=true

# --- AI Smart Entry (optional; leave OLLAMA_BASE_URL empty to disable) ---
# Backend-only. The browser never sees any of these.
OLLAMA_BASE_URL=
OLLAMA_MODEL=mistral
OLLAMA_API_KEY=
AI_BATCH_SIZE=10
AI_SCHEDULER_INTERVAL_SECONDS=30
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
AI_MAX_CONCURRENT_REQUESTS=1
# Optional safety limits
AI_MAX_INPUT_CHARS=200
AI_MAX_PROMPT_CHARS=6000
AI_MAX_PENDING_PER_USER=20
AI_DAILY_LIMIT=30
