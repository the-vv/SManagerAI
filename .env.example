# Copy to .env (never commit it). Used by docker-compose.yml.

# Public origin(s) allowed to call the API from a browser/WebView, comma separated.
# Web app origin + the Capacitor Android origin (https://localhost).
CORS_ORIGINS=https://finance.example.com,https://localhost,capacitor://localhost

# Sessions last this many days (sliding).
SESSION_TTL_DAYS=30

# The first account can always be created. Set true only if you want to allow more sign-ups.
ALLOW_REGISTRATION=false

# Optional Google login. Leave empty to hide the button. See docs/GOOGLE_OAUTH.md
GOOGLE_CLIENT_ID=

# Host port (loopback only) that your existing Caddy proxies to.
WEB_PORT=8080

# Enable Swagger UI at /api/docs (leave false in production).
SWAGGER_ENABLED=false
