# Copy to .env (never commit it). Used by docker-compose.yml.

# Public origin(s) allowed to call the API from a browser/WebView, comma separated.
# Web app origin + the Capacitor Android origin (https://localhost).
CORS_ORIGINS=https://finance.example.com,https://localhost,capacitor://localhost

# Sessions last this many days (sliding).
SESSION_TTL_DAYS=30

# The first account can always be created (and becomes the admin). With false, new accounts need an
# invite code created by the admin (see docs/INVITES.md). true = anyone can sign up.
ALLOW_REGISTRATION=false

# Optional Google login. Leave empty to hide the button. See docs/GOOGLE_OAUTH.md
GOOGLE_CLIENT_ID=

# Host port (loopback only) that your existing Caddy proxies to.
WEB_PORT=8080

# Enable Swagger UI at /api/docs (leave false in production).
SWAGGER_ENABLED=false

# --- AI Smart Entry (optional) ---
# Backend-only: URL/key of the Ollama REST gateway. Leave OLLAMA_BASE_URL empty to disable the feature.
OLLAMA_BASE_URL=
OLLAMA_MODEL=mistral
OLLAMA_API_KEY=
AI_BATCH_SIZE=10
AI_SCHEDULER_INTERVAL_SECONDS=30
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
AI_MAX_CONCURRENT_REQUESTS=1
